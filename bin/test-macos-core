#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
export SWIFTPM_MODULECACHE_OVERRIDE="$ROOT/macos/.build/module-cache"
export CLANG_MODULE_CACHE_PATH="$ROOT/macos/.build/module-cache"
# CLT Swift 6.4 does not discover its Swift Testing macro plugin in swiftbuild.
DEVELOPER_DIR_PATH="$(xcode-select -p)"
TESTING_PLUGIN="$DEVELOPER_DIR_PATH/usr/lib/swift/host/plugins/testing/libTestingMacros.dylib"
if [ "$DEVELOPER_DIR_PATH" = /Library/Developer/CommandLineTools ] && [ -f "$TESTING_PLUGIN" ]; then
  set -- -Xswiftc -load-plugin-library -Xswiftc "$TESTING_PLUGIN" "$@"
fi
exec swift test --package-path "$ROOT/macos" \
  --cache-path "$ROOT/macos/.build/cache" \
  --config-path "$ROOT/macos/.build/config" \
  --security-path "$ROOT/macos/.build/security" \
  --disable-sandbox --disable-xctest --enable-swift-testing "$@"
