#!/usr/bin/env sh
# Scan the repository for secrets with gitleaks, the same way CI does.
#
# Two passes, because they catch different mistakes. The history pass finds a
# secret that was committed and later removed, which is the case that keeps
# being forgotten; the tree pass finds one sitting in the working copy that has
# not been committed yet. CI runs both after a full-depth checkout.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed. Install it with 'brew install gitleaks'" >&2
  echo "or download a release from https://github.com/gitleaks/gitleaks/releases" >&2
  exit 1
fi

# --redact keeps a detected value out of this terminal and out of any log that
# captures it. A scan that prints the secret it found has leaked it twice.
echo "Scanning commit history under $ROOT"
gitleaks git "$ROOT" --redact --no-banner --verbose

echo "Scanning the working tree under $ROOT"
# This walks ignored directories too, so a populated build/ makes it slower
# here than in CI, where the checkout is clean.
gitleaks dir "$ROOT" --redact --no-banner

echo "PASS: no secrets found in the history or the working tree"