# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=mdwrite
pkgver=0.1.0
pkgrel=1
pkgdesc='Dead-simple Markdown writing app built with Qt Quick'
arch=('x86_64')
url='https://github.com/omacom-io/omawrite'
license=('MIT')
provides=('omawrite')
conflicts=('omawrite')
install='mdwrite.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/mdwrite "$pkgdir/usr/bin/mdwrite"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/mdwrite.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/mdwrite.svg"
  /usr/bin/install -Dm644 "$startdir/mdwrite.desktop" "$pkgdir/usr/share/applications/mdwrite.desktop"
}
